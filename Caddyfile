{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://stats.gulyuk.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.gulyuk.com; frame-src https://www.linkedin.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Hashed build assets never change (the share cards in /_og/ are named after a hash of their content).
	@assets path /_nuxt/* /_og/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Caddy may not know this extension; browsers want the manifest served with its own type.
	@manifest path /site.webmanifest
	header @manifest Content-Type application/manifest+json

	# HTML and payloads are revalidated, so a new deploy shows up immediately.
	@pages not path /_nuxt/* /_og/* /pdf/* /favicon.svg
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# /ideas/foo -> /ideas/foo/index.html, with no SPA fallback: unknown URLs are real 404s.
	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /not-found/index.html
		file_server
	}
}
